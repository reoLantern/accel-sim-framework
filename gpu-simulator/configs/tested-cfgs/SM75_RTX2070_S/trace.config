# Phase 3 Step A: MICRO 2025-calibrated instruction type latencies.
# Values from Huerta et al. SM75_RTX2070_S trace.config.
-trace_opcode_latency_initiation_int 2,2
-trace_opcode_latency_initiation_sp 2,2
-trace_opcode_latency_initiation_dp 25,16
-trace_opcode_latency_initiation_sfu 8,8
-trace_opcode_latency_initiation_tensor 8,8

# Fine-grained instruction types (MICRO 2025 additions).
-trace_opcode_latency_initiation_branch 2,1
-trace_opcode_latency_initiation_half 3,2
-trace_opcode_latency_initiation_uniform 2,2
-trace_opcode_latency_initiation_predicate 13,2
-trace_opcode_latency_initiation_miscellaneous_queue 2,2
-trace_opcode_latency_initiation_miscellaneous_no_queue 1,1

# TEX unit (only specialized unit kept; BRA/TENSOR/UDP remapped to
# BRANCH_OP/TENSOR_CORE_OP/UNIFORM_OP via turing_opcode.h).
-specialized_unit_2 1,4,200,4,4,TEX
-trace_opcode_latency_initiation_spec_op_2 200,4
